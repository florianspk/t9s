# Maintainer: Florian Specker <florianspk@gmail.com>

pkgname=t9s-git
_pkgname=t9s
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='k9s-inspired terminal UI for managing Talos Linux clusters (git)'
arch=('x86_64' 'aarch64')
url='https://github.com/florianspk/t9s'
license=('LicenseRef-t9s-non-commercial')
depends=('glibc')
makedepends=('go' 'git')
optdepends=(
  'talosctl: required at runtime — t9s drives it to talk to Talos nodes'
  'crane: browse the Siderolabs extension catalog'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local desc
  # Falls back to a commit-count version until the first tag exists.
  if desc=$(git describe --long --tags --abbrev=7 2>/dev/null) && [[ -n $desc ]]; then
    printf '%s' "$desc" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  go mod download
}

build() {
  cd "$_pkgname"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'

  go build -o build/t9s \
    -ldflags "-linkmode=external -compressdwarf=false -X main.version=$(git describe --tags --always --dirty)" \
    ./cmd/main.go
}

check() {
  cd "$_pkgname"
  go test ./...
}

package() {
  cd "$_pkgname"
  install -Dm755 build/t9s "$pkgdir/usr/bin/t9s"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
}
